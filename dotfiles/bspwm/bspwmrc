#!/bin/sh
# Kill and restart sxhkd
pgrep -x sxhkd > /dev/null || sxhkd &

# Monitor setup with meaningful workspace names
#bspc monitor -d 󰇩 󰖟 󰭹 󰊢  󰒱 󰓓 󰍳 󰊖 󰐌
bspc monitor -d I II III IV V VI VII VIII IX X
# 1:term 2:web 3:chat 4:dev 5:media 6:files 7:virt 8:sys 9:misc 10:scratch

# Window management
bspc config border_width         2
bspc config window_gap          4
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config focus_follows_pointer true
bspc config pointer_follows_focus true
bspc config automatic_scheme     alternate
bspc config initial_polarity     second_child
bspc config remove_disabled_monitors true
bspc config remove_unplugged_monitors true

# Colors (chaOS theme)
bspc config focused_border_color  "#E6007A"
bspc config normal_border_color   "#800341"
bspc config active_border_color   "#FA0079"
bspc config presel_feedback_color "#F8229B"

# Desktop-specific settings
# Dev desktop - wider gaps for multiple terminals
bspc config -d '^4' window_gap 8
# Chat desktop - tiled by default for multi-chat
bspc config -d '^3' automatic_scheme longest_side

# ──────────────────────────────────────────
# Window Rules by Category
# ──────────────────────────────────────────

# Terminal & Development (Desktop 1 & 4)
#bspc rule -a Alacritty desktop='^1' follow=on
bspc rule -a "Sublime Text" desktop='^4'
bspc rule -a "Visual Studio Code" desktop='^4'
bspc rule -a "jetbrains-*" desktop='^4'

# Web Browsers (Desktop 2)
bspc rule -a firefox desktop='^2' follow=on
bspc rule -a librewolf desktop='^2' follow=on
bspc rule -a Chromium desktop='^2' follow=on
bspc rule -a "Google-chrome" desktop='^2' follow=on

# Communication (Desktop 3)
bspc rule -a discord desktop='^3' follow=off
bspc rule -a Slack desktop='^3' follow=off
bspc rule -a TelegramDesktop desktop='^3' follow=off
bspc rule -a Signal desktop='^3' follow=off
bspc rule -a Element desktop='^3' follow=off
bspc rule -a Thunderbird desktop='^3' follow=off
bspc rule -a Beeper desktop='^3' follow=off
bspc rule -a whatsie desktop='^3' follow=off
bspc rule -a iamb desktop='^3' state=tiled

# Media & Entertainment (Desktop 5)
bspc rule -a mpv desktop='^5' state=fullscreen
bspc rule -a Spotify desktop='^5'
bspc rule -a ncspot desktop='^5'
bspc rule -a "VLC media player" desktop='^5'

# File Management (Desktop 6)
bspc rule -a Pcmanfm desktop='^6' follow=on
bspc rule -a Nautilus desktop='^6' follow=on
bspc rule -a Thunar desktop='^6' follow=on
bspc rule -a qBittorrent desktop='^6'
bspc rule -a Transmission-gtk desktop='^6'
bspc rule -a Transmission-qt desktop='^6'

# Virtual Machines & Remote (Desktop 7)
bspc rule -a VirtualBox desktop='^7'
bspc rule -a "VMware Workstation" desktop='^7'
bspc rule -a Virt-manager desktop='^7'
bspc rule -a "VNC Viewer" desktop='^7'
bspc rule -a Vncviewer desktop='^7'
bspc rule -a turbovnc desktop='^7'

# System Tools (Desktop 8)
bspc rule -a Pavucontrol desktop='^8' state=floating
bspc rule -a Blueman-manager desktop='^8' state=floating
bspc rule -a Nm-connection-editor desktop='^8' state=floating
bspc rule -a "System Monitor" desktop='^8'
bspc rule -a Htop desktop='^8'
bspc rule -a Btop desktop='^8'
bspc rule -a Bottom desktop='^8'

# Miscellaneous (Desktop 9)
bspc rule -a KeePassXC desktop='^9' state=floating
bspc rule -a "Ledger Live" desktop='^9'
bspc rule -a qdigidoc4 desktop='^9'

# ──────────────────────────────────────────
# Floating Rules
# ──────────────────────────────────────────

# Always float these
bspc rule -a Peek state=floating
bspc rule -a Screenkey manage=off
bspc rule -a flameshot state=floating
bspc rule -a Pinentry state=floating center=on
bspc rule -a "Picture-in-Picture" state=floating sticky=on
bspc rule -a "*:*:Picture in picture" state=floating sticky=on
bspc rule -a "*:*:Save File" state=floating center=on
bspc rule -a "*:*:Open File" state=floating center=on
bspc rule -a "*:*:File Upload" state=floating center=on
bspc rule -a "*:*:Choose Files" state=floating center=on
bspc rule -a "*:*:Preferences" state=floating center=on
bspc rule -a "*:*:Settings" state=floating center=on

bspc rule -a Alacritty:clipboard state=floating rectangle=800x400+560+340 center=on

# Browser extension popups (wallets, etc)
bspc rule -a "Chromium:chromium:*" state=floating center=on
bspc rule -a "Chromium-browser:chromium:*" state=floating center=on
bspc rule -a "*:*:Extension:*" state=floating center=on
bspc rule -a "*:*:Polkadot{.js} extension" state=floating center=on
bspc rule -a "*:*:Kepler Wallet" state=floating center=on
bspc rule -a "*:*:Prax Wallet" state=floating center=on
bspc rule -a "*:*:KeePassXC - Browser Access Request" state=floating center=on
bspc rule -a "*:*:MetaMask Notification" state=floating center=on

# Float with specific sizes
bspc rule -a Pavucontrol state=floating rectangle=800x600+0+0 center=on
bspc rule -a KeePassXC state=floating rectangle=900x700+0+0 center=on
bspc rule -a "Bluetooth Devices" state=floating rectangle=600x400+0+0 center=on

# ──────────────────────────────────────────
# Special Rules
# ──────────────────────────────────────────

# Sticky windows (visible on all desktops)
bspc rule -a "*:*:Telegram Media viewer" state=floating sticky=on
bspc rule -a "*:*:Discord Popout" state=floating sticky=on

# Locked windows (can't be closed with super+q)
bspc rule -a Syncthing locked=on

# ──────────────────────────────────────────
# Autostart
# ──────────────────────────────────────────

# Core utilities
xset r rate 200 50
xsetroot -cursor_name left_ptr &
setxkbmap -option caps:escape &

# Daemons
dunst &

# Background services
pgrep -x syncthing > /dev/null || syncthing --no-browser &
pgrep -x redshift > /dev/null || redshift &

# SSH agent (if not already running)
if [ -z "$SSH_AUTH_SOCK" ]; then
    eval $(ssh-agent -s)
fi

# Compositor (optional - uncomment for transparency/blur)
# picom -b --config ~/.config/picom/picom.conf &

# Polkit agent (for GUI sudo prompts)
# /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# Auto-start applications in background
# (sleep 3 && discord --start-minimized) &
# (sleep 3 && slack -u) &
# (sleep 3 && telegram-desktop -startintray) &

# Estonian ID card service
pgrep -x pcscd > /dev/null || sudo pcscd &

# Low battery notifier
# ~/.config/bspwm/scripts/low_bat_notifier.sh &
#

(sleep 2 && ~/.config/polybar/launch.sh) &
