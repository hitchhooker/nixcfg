[volume]
    summary = "Volume*"
    history_ignore = yes
    timeout = 1
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#a6e3a1"
    set_stack_tag = "volume"
    format = "🔊 %s"

[volume-up]
    summary = "*Volume*"
    body = "*[5-9][0-9]%*"
    history_ignore = yes
    timeout = 1
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#a6e3a1"
    set_stack_tag = "volume"
    format = "🔊 %s ↑"

[volume-down]
    summary = "*Volume*"
    body = "*[0-4][0-9]%*"
    history_ignore = yes
    timeout = 1
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#a6e3a1"
    set_stack_tag = "volume"
    format = "🔈 %s ↓"

[volume-mute]
    summary = "*Volume*"
    body = "*0%*|*mute*"
    history_ignore = yes
    timeout = 1
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#f38ba8"
    set_stack_tag = "volume"
    format = "🔇 Muted"

[brightness]
