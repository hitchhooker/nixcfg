    timeout = 2
    format = "🌐 <b>Network</b>\n%s"

[tailscale]
    appname = tailscale
    frame_color = "#1E1E1E"
    timeout = 2
    format = "🔗 <b>Tailscale</b>\n%s"

[ssh]
