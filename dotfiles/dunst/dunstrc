[global]
    monitor = 0
    follow = mouse
    width = 240
    height = 150
    origin = top-right
    offset = 10x10
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 240
    progress_bar_corner_radius = 0
    indicate_hidden = yes
    transparency = 5
    separator_height = 1
    padding = 6
    horizontal_padding = 6
    text_icon_padding = 0
    frame_width = 1
    frame_color = "#F8229B"
    gap_size = 2
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = Iosevka Nerd Font 8
    line_height = 1
    markup = full
    format = "<b>%a</b> %p\n%s\n<small>%b</small>"
    alignment = left
    vertical_alignment = center
    show_age_threshold = -1
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    word_wrap = yes
    icon_position = off
    sticky_history = yes
    history_length = 100
    dmenu = /run/current-system/sw/bin/rofi -dmenu -p "dunst history" -theme-str 'window {width: 50%;} listview {lines: 20;}'
    browser = /run/current-system/sw/bin/librewolf
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    timeout_slider = true
    ignore_dbusclose = false
    layer = overlay
    force_xwayland = false
    mouse_left_click = close_current
    mouse_middle_click = context
    mouse_right_click = close_all
    
[experimental]
    per_monitor_dpi = true

[urgency_low]
    background = "#000000"
    foreground = "#cccccc"
    frame_color = "#333333"
    timeout = 2
    override_pause_level = 30
    format = "ℹ️ <b>%a</b>\n%s\n<small>%b</small>"

[urgency_normal]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#e6007a"
    timeout = 3
    override_pause_level = 40
    format = "⚡ <b>%a</b>\n%s\n<small>%b</small>"

[urgency_critical]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#ff0000"
    timeout = 0
    override_pause_level = 50
    format = "🚨 <b>%a</b>\n%s\n<small>%b</small>"

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+shift+h
    context = ctrl+shift+period

[discord]
    desktop_entry = discord
    frame_color = "#5865F2"
    timeout = 2
    format = "💬 <b>Discord</b>\n%s\n<small>%b</small>"

[beeper]
    desktop_entry = beeper
    frame_color = "#00D4AA"
    timeout = 2
    format = "💭 <b>Beeper</b>\n%s\n<small>%b</small>"

[signal]
    desktop_entry = signal
    frame_color = "#3A76F0"
    timeout = 2
    format = "🔒 <b>Signal</b>\n%s\n<small>%b</small>"

[telegram]
    desktop_entry = telegram
    frame_color = "#2AABEE"
    timeout = 2
    format = "✈️ <b>Telegram</b>\n%s\n<small>%b</small>"

[slack]
    desktop_entry = slack
    frame_color = "#4A154B"
    timeout = 2
    format = "💼 <b>Slack</b>\n%s\n<small>%b</small>"

[thunderbird]
    desktop_entry = thunderbird
    frame_color = "#0A84FF"
    timeout = 3
    format = "📧 <b>Mail</b>\n%s\n<small>%b</small>"

[element]
