    frame_color = "#0DBD8B"
    timeout = 2
    format = "💎 <b>Element</b>\n%s\n<small>%b</small>"

[flameshot]
    appname = flameshot
    frame_color = "#FF6600"
    timeout = 1
    urgency = low
    format = "📸 <b>Screenshot</b>\n%s"

[transmission]
