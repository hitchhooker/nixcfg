    format = "🌙 %s ↓"

[battery-low]
    summary = "*battery*"
    body = "*[0-1][0-9]%*"
    urgency = critical
    timeout = 30
    frame_color = "#ff0000"
    format = "🔋 <b>%s</b>\n%b"

[battery-critical]
    summary = "*battery*"
    body = "*[0-9]%*"
