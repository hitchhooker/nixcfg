          nativeBuildInputs = [ pkg-config ];
          buildInputs = [ openssl ] ++ lib.optionals stdenv.isDarwin
            (with darwin.apple_sdk.frameworks; [ AppKit Security Cocoa]);
        };

        devShell = mkShell {
          buildInputs = [
            (rustNightly.override {
